# Optional. Cloudflare Pages can set the same key.
# Static builds embed this fallback if the env var is missing.
NEXT_PUBLIC_BINANCE_REF_URL=https://www.binance.com/activity/referral-entry/CPA?ref=yke3vhg.fed2xbu6CJZ

# Ingest only (scripts/import-csv.mjs / scripts/content-i18n.mjs).
# Not read at `npm run build`. Never commit the key.
KIE_API_KEY=
# Optional override. Default: https://api.kie.ai
# Endpoint: ${KIE_API_BASE}/gemini-3-5-flash-openai/v1/chat/completions
KIE_API_BASE=https://api.kie.ai
